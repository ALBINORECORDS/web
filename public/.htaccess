# Configuración del servidor de Hostinger (se publica junto con el sitio)

# Página propia para direcciones que no existen
ErrorDocument 404 /404.html

# www.albiñorecords.com → albiñorecords.com (una sola dirección para Google)
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
