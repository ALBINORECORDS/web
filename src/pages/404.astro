---
// Página para direcciones que no existen. Hostinger la muestra gracias a public/.htaccess.
// No se indexa en Google ni entra en el sitemap.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---
<Base titulo="Página no encontrada" descripcion="Esta página no existe." indexar={false}>
  <section class="no-encontrada contenedor">
    <p class="no-encontrada__codigo">404</p>
    <h1 class="titulo-l">Esta página <span class="acento">no existe</span></h1>
    <p class="texto-suave">Puede que el enlace esté mal escrito o que la página haya cambiado de lugar.</p>
    <a class="boton" href="/">Volver al inicio <Icon name="flecha" size={18} class="flecha" /></a>
  </section>
</Base>

<style>
  .no-encontrada {
    min-height: 80vh;
    min-height: 80svh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 20px;
    text-align: center;
    padding-top: 120px;
  }
  .no-encontrada__codigo {
    margin: 0;
    font-size: clamp(5rem, 18vw, 11rem);
    font-weight: 800;
    line-height: 1;
    opacity: .15;
  }
</style>
