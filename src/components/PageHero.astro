---
// Cabecera de páginas internas: imagen de fondo + título
interface Props { etiqueta?: string; imagen: string; clase?: string }
const { etiqueta, imagen, clase } = Astro.props;
---
<section class:list={['cabecera', clase]}>
  <div class="cabecera__fondo" style={`background-image: url('${imagen}')`}></div>
  <div class="contenedor cabecera__contenido">
    {etiqueta && <span class="etiqueta">{etiqueta}</span>}
    <h1 class="titulo-xl"><slot /></h1>
    <div class="cabecera__extra"><slot name="extra" /></div>
  </div>
</section>

<style>
  .cabecera {
    position: relative;
    min-height: 82vh;
    min-height: 82svh;
    display: flex;
    align-items: flex-end;
    padding: 140px 0 72px;
    overflow: hidden;
  }
  .cabecera__fondo {
    position: absolute;
    inset: -5% 0;
    background-size: cover;
    background-position: center;
    animation: acercar 2.4s var(--ease) both;
  }
  .cabecera__fondo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, .35) 0%, rgba(0, 0, 0, .6) 55%, var(--negro) 100%);
  }
  .cabecera__contenido { position: relative; display: grid; gap: 20px; padding-left: 64px; }
  .cabecera__contenido > * { animation: subir 1.1s var(--ease) both; }
  .cabecera__contenido > :nth-child(2) { animation-delay: .15s; }
  .cabecera__contenido > :nth-child(3) { animation-delay: .3s; }
  .cabecera__extra:empty { display: none; }

  @keyframes acercar { from { transform: scale(1.15); } to { transform: scale(1); } }
  @keyframes subir { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: none; } }

  @media (max-width: 767px) {
    .cabecera__contenido { padding-left: 0; }
  }
</style>
