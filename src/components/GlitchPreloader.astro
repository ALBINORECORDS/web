---
// Pantalla de carga (adaptada de plantilla-react/src/cine/GlitchPreloader.jsx): el logo
// tiembla y se parte en franjas mientras se precarga lo necesario para que la página se vea fluida.
//
// - Sale una sola vez por visita (sessionStorage) y solo con JavaScript: sin JS no se ve.
// - Mientras está: se pausan las animaciones de la página y no se puede hacer scroll, para que
//   la entrada (logo del inicio, títulos) empiece cuando se quita la pantalla y no por detrás.
// - Espera: fuentes + imágenes y fondos de la primera pantalla. Mínimo 1,2 s (lo que dura el
//   parpadeo) y máximo 6 s aunque algo tarde.
// - Al salir, en segundo plano: precarga las cabeceras y primeras imágenes de las otras páginas
//   y el resto de imágenes de esta, de a pocas, para que navegar y bajar sea fluido.
//
// Estado en <html data-precarga>: "on" (visible) → "saliendo" (fundido) → sin atributo.
// Otros scripts esperan el evento `precarga:fin` (ver IntroLogo y Base).
const logo = '/media/logo-blanco-200.webp';
---
<script is:inline>
  // Antes de pintar: decide si sale la pantalla de carga en esta visita
  (function () {
    var visto = false;
    try { visto = sessionStorage.getItem('albino-precarga') === '1'; } catch (e) {}
    if (!visto) document.documentElement.setAttribute('data-precarga', 'on');
  })();
</script>
<div class="glitch-load" role="status" aria-label="Cargando">
  <div class="glitch-load__logo">
    <img src={logo} alt="" width="200" height="293" fetchpriority="high" />
    <img src={logo} alt="" width="200" height="293" aria-hidden="true" />
    <img src={logo} alt="" width="200" height="293" aria-hidden="true" />
  </div>
</div>

<style is:global>
  .glitch-load { display: none; }
  html[data-precarga] .glitch-load {
    position: fixed;
    inset: 0;
    z-index: 350;
    display: grid;
    place-items: center;
    background: #000;
    transition: opacity .32s;
  }
  html[data-precarga="saliendo"] .glitch-load { opacity: 0; pointer-events: none; }
  /* Mientras carga: sin scroll y con las animaciones de la página en pausa */
  html[data-precarga="on"] { overflow: hidden; }
  html[data-precarga="on"] body > :not(.glitch-load),
  html[data-precarga="on"] body > :not(.glitch-load) *,
  html[data-precarga="on"] body > :not(.glitch-load) *::before,
  html[data-precarga="on"] body > :not(.glitch-load) *::after { animation-play-state: paused !important; }

  /* El parpadeo dura lo mismo que el mínimo de la pantalla (1,2 s) */
  .glitch-load__logo { position: relative; width: 92px; animation: glitch-flicker 1.2s steps(1) both; }
  .glitch-load__logo img { display: block; width: 100%; height: auto; }
  .glitch-load__logo img + img { position: absolute; inset: 0; mix-blend-mode: screen; }
  .glitch-load__logo img:nth-child(2) { filter: drop-shadow(-3px 0 0 var(--acento)); animation: glitch-a 1.1s steps(1) infinite; }
  .glitch-load__logo img:nth-child(3) { filter: drop-shadow(3px 0 0 #39e0c8); animation: glitch-b .9s steps(1) infinite; }

  @keyframes glitch-flicker {
    0%, 12% { opacity: 0; }
    14%, 18% { opacity: 1; }
    20%, 24% { opacity: .15; }
    26%, 60% { opacity: 1; }
    62%, 64% { opacity: .3; }
    66%, 100% { opacity: 1; }
  }
  @keyframes glitch-a {
    0%, 100% { clip-path: inset(0 0 100% 0); transform: none; }
    18% { clip-path: inset(12% 0 62% 0); transform: translateX(-7px); }
    34% { clip-path: inset(0 0 100% 0); transform: none; }
    62% { clip-path: inset(58% 0 18% 0); transform: translateX(9px); }
    74% { clip-path: inset(0 0 100% 0); transform: none; }
  }
  @keyframes glitch-b {
    0%, 100% { clip-path: inset(100% 0 0 0); transform: none; }
    26% { clip-path: inset(38% 0 40% 0); transform: translateX(8px); }
    40% { clip-path: inset(100% 0 0 0); transform: none; }
    78% { clip-path: inset(72% 0 6% 0); transform: translateX(-6px); }
    88% { clip-path: inset(100% 0 0 0); transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .glitch-load__logo, .glitch-load__logo img { animation: none; }
    .glitch-load__logo img + img { display: none; }
  }
</style>

<script>
  import { menu } from '../data/site';

  const root = document.documentElement;
  // Mínimo corto (1,2 s) para no retrasar demasiado la primera vista (LCP en Google)
  const MIN = matchMedia('(prefers-reduced-motion: reduce)').matches ? 300 : 1200;
  const MAX = 6000;
  const SALIDA = 320;
  const espera = (ms: number) => new Promise((r) => setTimeout(r, ms));

  // Carga (y decodifica) una imagen; nunca falla, para no trabar la pantalla de carga
  const cargar = (src: string) =>
    new Promise<void>((listo) => {
      const img = new Image();
      img.decoding = 'async';
      img.onload = () => img.decode().catch(() => {}).finally(listo);
      img.onerror = () => listo();
      img.src = src;
    });

  const urlsDeFondo = (el: Element) =>
    [...getComputedStyle(el).backgroundImage.matchAll(/url\(["']?([^"')]+)["']?\)/g)].map((m) => m[1]);

  // Lo que se ve en la primera pantalla: imágenes, pósters de video y fondos CSS
  function primeraPantalla() {
    const alto = innerHeight * 1.1;
    const enVista = (el: Element) => {
      const r = el.getBoundingClientRect();
      return r.bottom > 0 && r.top < alto && r.width > 0;
    };
    const urls = new Set<string>();
    document.querySelectorAll<HTMLImageElement>('main img').forEach((img) => {
      if (enVista(img)) urls.add(img.currentSrc || img.src);
    });
    document.querySelectorAll<HTMLVideoElement>('main video[poster]').forEach((v) => enVista(v) && urls.add(v.poster));
    document.querySelectorAll('main *').forEach((el) => {
      if (enVista(el)) urlsDeFondo(el).forEach((u) => urls.add(u));
    });
    return [...urls].filter(Boolean);
  }

  // En segundo plano, de a 3: el resto de imágenes de esta página y la primera pantalla de las otras
  async function calentar() {
    const pendientes = new Set<string>();
    document.querySelectorAll<HTMLImageElement>('main img').forEach((img) => pendientes.add(img.src));
    document.querySelectorAll<HTMLVideoElement>('main video[poster]').forEach((v) => pendientes.add(v.poster));

    const actual = location.pathname;
    for (const { href } of menu) {
      if (href === actual) continue;
      // Del HTML de la otra página solo se sacan sus imágenes: Hostinger no deja guardar
      // el HTML en caché (no-store), pero las imágenes sí se guardan y es lo que más pesa.
      try {
        const html = await (await fetch(href)).text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        // Fondos en línea (cabeceras) y las primeras imágenes de esa página
        doc.querySelectorAll<HTMLElement>('main [style*="url("]').forEach((el) =>
          urlsDeFondo(el).forEach((u) => pendientes.add(new URL(u, location.href).href)));
        [...doc.querySelectorAll<HTMLImageElement>('main img')].slice(0, 6).forEach((img) =>
          pendientes.add(new URL(img.getAttribute('src')!, location.href).href));
      } catch {}
    }

    const cola = [...pendientes];
    const trabajador = async () => {
      for (let src = cola.shift(); src; src = cola.shift()) await cargar(src);
    };
    await Promise.all([trabajador(), trabajador(), trabajador()]);
  }

  async function correr() {
    const inicio = performance.now();
    // Las imágenes lazy de la primera pantalla también cuentan: se piden ya
    const criticos = [document.fonts.ready.then(() => {}), ...primeraPantalla().map(cargar)];
    await Promise.race([Promise.allSettled(criticos), espera(MAX)]);
    const falta = MIN - (performance.now() - inicio);
    if (falta > 0) await espera(falta);

    // Se quita la pantalla: las animaciones de la página arrancan durante el fundido
    try { sessionStorage.setItem('albino-precarga', '1'); } catch {}
    root.setAttribute('data-precarga', 'saliendo');
    document.dispatchEvent(new Event('precarga:fin'));
    await espera(SALIDA);
    root.removeAttribute('data-precarga');

    const enReposo = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 2000 }) : setTimeout(fn, 600);
    enReposo(() => { calentar(); });
  }

  if (root.getAttribute('data-precarga') === 'on') correr();
</script>
