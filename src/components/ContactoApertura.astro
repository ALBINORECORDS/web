---
// Apertura de Contacto: una pantalla con el título "Hablemos", que sube letra por letra al
// cargar, y el botón "Escribir mensaje" que lleva al formulario.
// (Antes tenía cuatro fotos que se abrían hacia las esquinas con el scroll; se quitaron el 2026-11-19.)
// Sin JavaScript o con movimiento reducido el título se ve completo desde el inicio.
import Icon from './Icon.astro';

const titulo = 'Hablemos';
---
<section class="apertura" data-apertura>
  <div class="apertura__escena">
    <div class="apertura__texto">
      <h1 class="apertura__titulo" aria-label={titulo}>
        {[...titulo].map((letra, i) => <span aria-hidden="true" style={`--l:${i}`}>{letra}</span>)}
      </h1>
      <div class="apertura__botones">
        <a class="boton magnetico sin-borde" href="#formulario">Escribir mensaje <Icon name="abajo" size={18} class="flecha" /></a>
      </div>
    </div>
  </div>
</section>

<noscript><style>.apertura__titulo span, .apertura__botones { opacity: 1 !important; transform: none !important; }</style></noscript>

<style>
  .apertura { position: relative; }
  .apertura__escena {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    isolation: isolate;
  }

  /* El título queda justo en el centro de la pantalla y el botón debajo */
  .apertura__texto {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    grid-template-rows: 1fr auto 1fr;
    justify-items: center;
    padding: 0 24px;
    text-align: center;
  }
  .apertura__titulo { grid-row: 2; }
  .apertura__botones { grid-row: 3; align-self: end; margin-bottom: clamp(32px, 7vh, 72px); }
  .apertura__titulo {
    display: flex;
    font-family: var(--font-display);
    font-stretch: var(--ancho-display);
    font-weight: 700;
    font-size: clamp(54px, 12vw, 190px);
    line-height: .9;
    text-transform: uppercase;
  }
  /* Letras: suben desde abajo una tras otra al cargar la página */
  .apertura__titulo span {
    display: inline-block;
    transform: translateY(110%) rotate(8deg);
    opacity: 0;
    transition: transform .9s calc(.2s + var(--l) * .05s) var(--ease), opacity .6s calc(.2s + var(--l) * .05s);
  }
  .apertura__titulo span:last-child { color: var(--texto); }
  /* Botón sin fondo ni borde: solo el texto y la flecha */
  .sin-borde { background: transparent; border: 0; }
  .apertura__botones {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity .8s .65s var(--ease), transform .8s .65s var(--ease);
  }

  .apertura.is-abierta .apertura__titulo span,
  .apertura.is-abierta .apertura__botones { opacity: 1; transform: none; }
</style>

<script>
  // Con las transiciones de página este script corre una sola vez:
  // la sección se vuelve a buscar en cada página (astro:page-load).
  const conMovimiento = !matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Botones magnéticos (Cta de plantilla-react): se inclinan hacia el puntero
  function magnetizar(raiz: ParentNode) {
    if (!conMovimiento || !matchMedia('(pointer: fine)').matches) return;
    raiz.querySelectorAll<HTMLElement>('.magnetico:not([data-iman])').forEach((el) => {
      el.dataset.iman = '';
      el.addEventListener('pointermove', (e) => {
        const caja = el.getBoundingClientRect();
        el.style.translate = `${((e.clientX - caja.left - caja.width / 2) * 0.12).toFixed(1)}px ${((e.clientY - caja.top - caja.height / 2) * 0.22).toFixed(1)}px`;
      });
      el.addEventListener('pointerleave', () => { el.style.translate = ''; });
    });
  }

  function iniciar() {
    const seccion = document.querySelector<HTMLElement>('[data-apertura]');
    if (!seccion) return;
    magnetizar(seccion);
    // Un cuadro después de pintar, para que las letras animen al entrar
    requestAnimationFrame(() => requestAnimationFrame(() => seccion.classList.add('is-abierta')));
  }
  // Si este script llega con una página nueva, puede cargarse después del aviso
  // de "página lista": por eso también se inicia en cuanto se ejecuta.
  iniciar();
  document.addEventListener('astro:page-load', iniciar);
</script>
